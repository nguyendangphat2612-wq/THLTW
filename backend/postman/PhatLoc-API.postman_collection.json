{
  "info": {
    "name": "PhatLoc API",
    "description": "Simple Postman collection for auth and CRUD testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "email", "value": "admin999@example.com" },
    { "key": "categoryId", "value": "" },
    { "key": "mobileCategoryId", "value": "" },
    { "key": "brandId", "value": "" },
    { "key": "productId", "value": "" }
  ],
  "item": [
    {
      "name": "Register",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('email', `api-test-${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/register"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"password123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/login"
      }
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/me"
      }
    },
    {
      "name": "Admin Profile",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/admin"
      }
    },
    {
      "name": "Categories List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/categories?per_page=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('mobileCategoryId', pm.response.json().data[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Category Details",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/categories/{{mobileCategoryId}}"
      }
    },
    {
      "name": "Create Category",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cat_name\": \"Điện thoại test\",\n  \"alias\": \"dien-thoai-test\",\n  \"parent_id\": 0,\n  \"status\": 1,\n  \"sort_order\": 1\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('categoryId', pm.response.json().data.cat_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Category",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cat_name\": \"Điện thoại test mới\",\n  \"alias\": \"dien-thoai-test-moi\",\n  \"parent_id\": 0,\n  \"status\": 1,\n  \"sort_order\": 2\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/categories/{{categoryId}}"
      }
    },
    {
      "name": "Delete Category",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/categories/{{categoryId}}"
      }
    },
    {
      "name": "Products List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products?per_page=10"
      }
    },
    {
      "name": "Brands List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/brands?per_page=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('brandId', pm.response.json().data[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Brand Details",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/brands/{{brandId}}"
      }
    },
    {
      "name": "Create Product",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_name\": \"iPhone 16\",\n  \"alias\": \"iphone-16\",\n  \"cat_id\": {{brandId}},\n  \"brand_id\": {{brandId}},\n  \"detail\": \"Sản phẩm thử nghiệm\",\n  \"price\": 25000000,\n  \"sale_price\": 22000000,\n  \"status\": 1\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('productId', pm.response.json().data.product_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Product Details",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    },
    {
      "name": "Update Product",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_name\": \"iPhone 16 Pro\",\n  \"alias\": \"iphone-16-pro\",\n  \"cat_id\": {{brandId}},\n  \"brand_id\": {{brandId}},\n  \"detail\": \"Sản phẩm cập nhật\",\n  \"price\": 29000000,\n  \"sale_price\": 26000000,\n  \"status\": 1\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    },
    {
      "name": "Delete Product",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    },
    {
      "name": "Create Brand",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cat_name\": \"Postman Test Brand\",\n  \"parent_id\": {{mobileCategoryId}},\n  \"status\": 1,\n  \"sort_order\": 99\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/brands"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('brandId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Brand",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cat_name\": \"Postman Test Brand Updated\",\n  \"parent_id\": {{mobileCategoryId}},\n  \"status\": 1,\n  \"sort_order\": 100\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/brands/{{brandId}}"
      }
    },
    {
      "name": "Delete Brand",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/brands/{{brandId}}"
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/logout"
      }
    }
  ]
}